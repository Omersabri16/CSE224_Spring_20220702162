      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.27998");
	}
	cell_fall(scalar) {
          values("0.30249");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.27998");
	}
	cell_fall(scalar) {
          values("0.30249");
	}
      }
    }
    pin("rst") {
