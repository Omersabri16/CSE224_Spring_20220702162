	cell_rise(scalar) {
          values("0.28533");
	}
	cell_fall(scalar) {
          values("0.30706");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
